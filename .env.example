# ─────────────────────────────────────────────────────────────
# CardIndex environment variables
# Copy this file to .env.local and fill in your values.
# Add all of these to Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings → API
# 3. Copy the Project URL and anon/public key
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — used only in API routes (never exposed to browser)
# Found in Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Poketrace Pricing API ─────────────────────────────────────
# 1. Register at https://poketrace.com/dashboard
# 2. Copy your API key
POKETRACE_API_KEY=pc_live_xxxxxxxxxxxxxxxxxxxx

# ── PokemonPriceTracker (JP card eBay pricing fallback) ──────
# Used when Poketrace only has CardMarket AGGREGATED data for a JP card.
# Free plan: 100 credits/day (2 per lookup). Results cached 24h.
# Register at https://www.pokemonpricetracker.com
POKEMON_PRICE_TRACKER_API_KEY=

# ── Slack webhooks ───────────────────────────────────────────
# Used for new user sign-up alerts and issue report alerts.
# Create incoming webhooks at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Optional: separate channel just for issue reports (falls back to SLACK_WEBHOOK_URL)
# SLACK_WEBHOOK_REPORTS_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Resend (transactional email) ─────────────────────────────
# Used to send security notification emails (e.g. password changed).
# Get your API key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=CardIndex <noreply@yourdomain.com>

# ── Stripe (add when ready for payments) ─────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
